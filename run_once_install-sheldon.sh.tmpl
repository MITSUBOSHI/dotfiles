#!/bin/bash
# Install sheldon if not already installed

if ! command -v sheldon &> /dev/null; then
  echo "Installing sheldon..."
  {{- if eq .chezmoi.os "darwin" }}
  brew install sheldon
  {{- else if eq .chezmoi.os "linux" }}
  curl --proto '=https' -fLsS https://rossmacarthur.github.io/install/crate.sh \
    | bash -s -- --repo rossmacarthur/sheldon --to ~/.local/bin
  {{- end }}
else
  echo "sheldon is already installed"
fi

# Note: Run 'sheldon lock' manually to generate lock file and cache plugins
# This is optional - sheldon will work without a lock file (just slower on first load)
