#!/bin/bash
# Install sheldon if not already installed

if ! command -v sheldon &> /dev/null; then
  echo "Installing sheldon..."
  {{- if eq .chezmoi.os "darwin" }}
  brew install sheldon
  {{- else if eq .chezmoi.os "linux" }}
  curl --proto '=https' -fLsS https://rossmacarthur.github.io/install/crate.sh \
    | bash -s -- --repo rossmacarthur/sheldon --to ~/.local/bin
  {{- end }}
else
  echo "sheldon is already installed"
fi

# Initialize sheldon plugins with HTTPS (bypass SSH insteadOf)
# The global git config has: url."git@github.com:".insteadOf = https://github.com/
# This causes sheldon to hang, so we temporarily rename .gitconfig
echo "Initializing sheldon plugins..."

if [ -f ~/.gitconfig ]; then
  mv ~/.gitconfig ~/.gitconfig.sheldon-tmp
  sheldon lock --update
  mv ~/.gitconfig.sheldon-tmp ~/.gitconfig
else
  sheldon lock --update
fi

echo "✓ sheldon setup complete"
